{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "types": ["vite/client"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.jsx"],
    "exclude": [
        "node_modules",
        "dist",
        "src/**/*.test.*",
        "src/**/*.spec.*"
    ]
}